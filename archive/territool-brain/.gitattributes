# Ready for Git LFS if the owner chooses "git + media via LFS".
# Harmless until then: without `git lfs install` these lines are simply ignored.
# If the choice is "git, media excluded" instead, delete this file and add the media paths to .gitignore.
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text

# Keep text diffs readable and line endings stable across machines.
*.md   text eol=lf
*.js   text eol=lf
*.json text eol=lf
