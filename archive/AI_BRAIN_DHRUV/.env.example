# Copy to .env in this folder. Never commit .env.
# Typed graph chat uses Anthropic only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VERSION=2023-06-01
# Optional. If set, /api/chat requires header x-brain-secret (or Bearer).
GRAPH_CHAT_SECRET=
# Public origin for Gmail OAuth (production graph).
BRAIN_PUBLIC_URL=https://tt-gmail-allow.vercel.app
# Encrypts Gmail refresh cookies. Required for /gmail.html Allow.
GMAIL_TOKEN_SECRET=
# Google Cloud OAuth Web client. Redirect: {BRAIN_PUBLIC_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional durable refresh tokens if cookies are missing (names only here).
# GMAIL_REFRESH_PICWA=
# GMAIL_REFRESH_TERRITOOL=
